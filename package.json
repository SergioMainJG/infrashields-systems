{
  "name": "infrashield-systems",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nubx ng serve --hmr --live-reload -o --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "engineStrict": true,
  "engines": {
